extends ../layout

block content
    a(class=".hover:text-blue-300" href="/comics").text-blue-400.mb-6.inline-block &larr; Wróć do listy

    div(class="md:flex-row").bg-gray-800.p-6.flex.flex-col.gap-8
        img.w-64.rounded-lg.shadow-md(src=`${comic.cover}`, alt=`Okładka ${comic.name}`)
        div
            h1.text-4xl.font-bold.mb-2 #{comic.title}
            p.text-gray-400.text-sm Numer ID: #{comic.id}
            p.text-gray-400.text-lg.mb-4 Pierwsze wydanie: #{comic.releaseYear} rok
            ul.text-gray-400.text-lg.mb-4 Autorzy:
                li.text-gray-400.text-m.ml-4 Scenariusz: #{comic.creators.writer}
                li.text-gray-400.text-m.ml-4 Rysunki: #{comic.creators.artist}
            p.text-gray-300 #{comic.description}

            if userRole === 'admin'
                div.w-full.flex.justify-center.my-10
                    button(onclick=`deleteComic(${comic.id})`).text-white.bg-red-600.p-6.rounded-lg Usuń komiks

                    script.
                        function deleteComic(id){
                            fetch(`/comics/delete/${id}`, {
                                method: "DELETE"
                            }).then(res => {
                                if(res.ok){
                                    window.location.href = "/comics";
                                }else{
                                    alert("Blad podczas usuwania");
                                }
                            });
                        }